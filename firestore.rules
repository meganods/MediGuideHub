rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users — any signed-in user can read profiles, and write their own.
    match /users/{userId} {
      allow read, write: if true;

      match /notifications/{notificationId} {
        allow read, write: if true;
      }

      match /savedArticles/{postId} {
        allow read, write: if true;
      }
    }

    // 2. Blog Posts — public read, open write for development
    match /posts/{postId} {
      allow read, write: if true;
    }

    // 3. Contact Messages — open read and write for development
    match /contactMessages/{messageId} {
      allow read, write: if true;
    }

    // 4. Newsletter Subscribers — open read and write for development
    match /newsletterSubscribers/{subscriberId} {
      allow read, write: if true;
    }

    // 5. Testimonials, FAQs, Site Settings — open read and write
    match /testimonials/{id} {
      allow read, write: if true;
    }

    match /faqs/{id} {
      allow read, write: if true;
    }

    match /siteSettings/{id} {
      allow read, write: if true;
    }
  }
}
