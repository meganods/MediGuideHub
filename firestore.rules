rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: Check user role
    function hasRole(role) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == role;
    }

    // Role-specific helpers
    function isAdmin() {
      return hasRole('admin') || 
        (isAuthenticated() && (
          request.auth.token.email == 'admin@mediguide.com' ||
          request.auth.token.email == 'vishalratanshakya@gmail.com' ||
          request.auth.token.email == 'vishal@gmail.com' ||
          request.auth.token.email == 'ratanvishal2003@gmail.com'
        ));
    }

    function isEditor() {
      return isAdmin() || hasRole('editor');
    }

    function isAuthor() {
      return isEditor() || hasRole('author');
    }

    // Helper: Check if user is accessing their own user document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if post is published and not soft-deleted
    function isPublicContent(data) {
      return data.status == 'published' && (!('deleted' in data) || data.deleted == false);
    }

    // 1. User Profiles & Settings
    match /users/{userId} {
      allow create: if isAuthenticated();
      allow read: if isOwner(userId) || isEditor();
      allow write: if isOwner(userId) || isAdmin();

      // Nested collections: bookmarks, readingHistory, preferences
      match /{document=**} {
        allow read, write: if isOwner(userId) || isEditor();
      }
    }

    // 2. Blog Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAuthor();
    }

    // 3. Categories
    match /categories/{catId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 4. FAQs
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isEditor();
    }

    // 5. Messages / Contact Inbox
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, write: if isEditor();
    }

    // 6. Newsletter Subscribers
    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow read, write: if isEditor();
    }

    // 7. Site Settings & SEO Settings
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /seoSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Legal Pages
    match /legalPages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Activity Logs
    match /activityLogs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // 10. Search Analytics
    match /searchAnalytics/{id} {
      allow create: if true;
      allow read: if isEditor();
      allow update, delete: if isAdmin();
    }
  }
}
