rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if authenticated user is an administrator (fail-safe by official admin email & profile role)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@mediguide.com' ||
        request.auth.token.email == 'Admin@mediguide.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. Users Profiles
    match /users/{userId} {
      allow create: if isAuthenticated();
      allow read, write: if isOwner(userId) || isAdmin();

      // Nested sub-collections matching user settings
      match /notifications/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /savedArticles/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /readingHistory/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /bookmarks/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /userPreferences/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /newsletterSubscriptions/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /searchHistory/{id} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 2. Blog Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Healthcare Categories
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Legal Disclosures & Policies
    match /legalPages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Contact Inquiries / Support Messages
    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 6. Newsletter Subscribers
    match /newsletterSubscribers/{subscriberId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 7. Site Content helpers: FAQs, Site settings, testimonials
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Search analytics
    match /searchAnalytics/{id} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    match /popularSearches/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
